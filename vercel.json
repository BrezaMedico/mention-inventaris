{
  "crons": [
    {
      "path": "/api/cron/keepalive",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/task-reminder?mode=morning",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/task-reminder?mode=afternoon",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/overdue",
      "schedule": "0 1 * * *"
    }
  ]
}
